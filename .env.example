# Copy this file to `.env` and set your address. That's all you need.

# The Bitcoin address that receives the reward if you find a block. (required)
BTC_ADDRESS=your_bitcoin_address_here

# --- Everything below is optional -------------------------------------------

# Stratum pool, as host:port. The default is a solo pool: if you find a block,
# the reward (minus the pool's fee) goes to BTC_ADDRESS.
# POOL=solo.ckpool.org:3333

# A name for this machine, shown on the pool's dashboard.
# WORKER=macbook

# Pool password. Almost every pool ignores it.
# POOL_PASSWORD=x

# How hard to push the GPU: the percentage of time spent hashing (1-100).
# Lower it to keep the machine cooler and quieter.
# INTENSITY=100
